#!/bin/sh

set -e

LC_ALL=C

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="repo procps android-sdk ziptime lib32z-dev bzip2 libbz2-dev libghc-bzlib-dev optipng libc6-dev-i386 lib32ncurses5-dev x11proto-core-dev libx11-dev libgl1-mesa-dev unzip python-dev-is-python3 python3-venvlibffi-dev libxslt1-dev libjpeg-dev adb fastboot android-sdk-libsparse-utils mkbootimg libncurses5 fontconfig"
PKG_LIB="${PKG_LIB} bc bison build-essential ccache curl flex g++-multilib gcc-multilib git git-lfs gnupg gperf imagemagick lib32ncurses-dev lib32readline-dev lib32z1-dev libelf-dev liblz4-tool lz4 libncurses6 libncurses-dev libsdl1.2-dev libssl-dev libwxgtk3.2-dev libxml2 libxml2-utils lzop pngcrush rsync schedtool squashfs-tools xsltproc zip zlib1g-dev"
PKG_LIB="${PKG_LIB} openjdk-17-jdk openjdk-17-jre cpio"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

